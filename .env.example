# Example environment variables for local Docker Compose startup.
# Copy this file to .env and change values if needed:
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=gym-crm-application
POSTGRES_USER=gym
POSTGRES_PASSWORD=gym
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MongoDB
MONGODB_DATABASE=workload_service
MONGODB_PORT=27017

# ActiveMQ
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
ACTIVEMQ_PORT=61616
ACTIVEMQ_WEB_PORT=8161

# Application ports
DISCOVERY_SERVER_PORT=8761
GYM_CORE_SERVICE_PORT=8081
WORKLOAD_SERVICE_PORT=8082
API_GATEWAY_PORT=8080

POSTGRES_HOST=postgres
REDIS_HOST=redis
MONGODB_HOST=mongodb
ACTIVEMQ_HOST=activemq
DISCOVERY_HOST=discovery-server
WORKLOAD_HOST=workload-service

# Security
JWT_SECRET=local-dev-secret-key-local-dev-secret-key

# Messaging
TRAINER_WORKLOAD_QUEUE=trainer.workload.queue
TRAINER_WORKLOAD_DLQ=trainer.workload.queue.dlq

# Workload message redelivery
WORKLOAD_MESSAGE_MAX_REDELIVERIES=3
WORKLOAD_MESSAGE_INITIAL_REDELIVERY_DELAY_MS=1000
WORKLOAD_MESSAGE_REDELIVERY_DELAY_MS=2000
WORKLOAD_MESSAGE_CONSUMER_CONCURRENCY=2
